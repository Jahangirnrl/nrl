void executeSunriseSchedule(int scheduleId, int relay, String schedulePath) {
  // Get sunrise time from RTDB (stored as string "HH:MM:SS")
  if (Firebase.RTDB.getString(&fbdo, "HOME/ROOM_2/sunrise")) {
    String sunriseStr = fbdo.stringData();
    
    if (sunriseStr != "" && sunriseStr != "--:--") {
      // Get offset from schedule (integer)
      int offset = 0;
      if (Firebase.RTDB.getInt(&fbdo, (schedulePath + "/offset").c_str())) {
        offset = fbdo.intData();
      }
      
      // Convert sunrise string to time_t
      struct tm sunrise_tm = {0};
      sscanf(sunriseStr.c_str(), "%d:%d:%d", &sunrise_tm.tm_hour, &sunrise_tm.tm_min, &sunrise_tm.tm_sec);
      
      // Get current time
      struct tm timeinfo;
      if (!getLocalTime(&timeinfo)) {
        Serial.println("Failed to obtain current time");
        return;
      }
      
      // Set sunrise to today's date
      sunrise_tm.tm_year = timeinfo.tm_year;
      sunrise_tm.tm_mon = timeinfo.tm_mon;
      sunrise_tm.tm_mday = timeinfo.tm_mday;
      sunrise_tm.tm_isdst = timeinfo.tm_isdst;
      
      // Apply offset
      sunrise_tm.tm_min += offset;
      time_t scheduledTime = mktime(&sunrise_tm); // Normalize after offset
      
      time_t now;
      time(&now);
      
      // Debug info
      Serial.printf("Schedule%d: Sunrise: %s, Offset: %d min, ", scheduleId, sunriseStr.c_str(), offset);
      
      char scheduledStr[9];
      strftime(scheduledStr, sizeof(scheduledStr), "%H:%M:%S", &sunrise_tm);
      Serial.printf("Scheduled: %s, ", scheduledStr);
      
      char nowStr[9];
      strftime(nowStr, sizeof(nowStr), "%H:%M:%S", &timeinfo);
      Serial.printf("Current: %s\n", nowStr);
      
      // Check if current time matches scheduled time (within 60 seconds)
      if (now >= scheduledTime && now < scheduledTime + 60) {
        // Get action (ON/OFF)
        if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/action").c_str())) {
          bool action = fbdo.boolData();
          setRelayNB(relay, action);
          
          Serial.printf("🤖 Schedule%d: Relay%d %s at Sunrise%s\n", 
                        scheduleId, relay + 1, action ? "ON" : "OFF",
                        offset != 0 ? (offset > 0 ? " +" : " ") + String(offset) + "min" : "");
          
          // Update last execution time
          Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                  "Sunrise" + String(offset != 0 ? (offset > 0 ? " +" : " ") + String(offset) + "min" : "") + ": " + String(scheduledStr));
        }
      }
    } else {
      Serial.printf("  ⚠ Schedule%d: Invalid sunrise time format\n", scheduleId);
    }
  } else {
    Serial.printf("  ⚠ Schedule%d: Failed to read sunrise time\n", scheduleId);
  }
}

void executeSunsetSchedule(int scheduleId, int relay, String schedulePath) {
  // Get sunset time from RTDB (stored as string "HH:MM:SS")
  if (Firebase.RTDB.getString(&fbdo, "HOME/ROOM_2/sunset")) {
    String sunsetStr = fbdo.stringData();
    
    if (sunsetStr != "" && sunsetStr != "--:--") {
      // Get offset from schedule (integer)
      int offset = 0;
      if (Firebase.RTDB.getInt(&fbdo, (schedulePath + "/offset").c_str())) {
        offset = fbdo.intData();
      }
      
      // Convert sunset string to time_t
      struct tm sunset_tm = {0};
      sscanf(sunsetStr.c_str(), "%d:%d:%d", &sunset_tm.tm_hour, &sunset_tm.tm_min, &sunset_tm.tm_sec);
      
      // Get current time
      struct tm timeinfo;
      if (!getLocalTime(&timeinfo)) {
        Serial.println("Failed to obtain current time");
