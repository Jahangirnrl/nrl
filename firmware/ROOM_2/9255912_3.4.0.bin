// -------------------- TIME & UPTIME --------------------

// Calculates and formats the device uptime (X days HH:MM:SS)
String getUptime() {
  unsigned long ms = millis();
  unsigned long totalSeconds = ms / 1000;
  unsigned int days    = totalSeconds / 86400;
  unsigned int hours   = (totalSeconds % 86400) / 3600;
  unsigned int minutes = (totalSeconds % 3600) / 60;
  unsigned int seconds = totalSeconds % 60;

  char buf[50];
  if (days > 0) {    sprintf(buf, "%u day%s %02u:%02u:%02u", days, (days > 1 ? "s" : ""), hours, minutes, seconds);  } else { sprintf(buf, "%02u:%02u:%02u", hours, minutes, seconds); }  return String(buf); }


