void handleFirmwareUpdate() {
  if (!updateRequest) return;

  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    
    // 1. Get the Latest Version Number (Same logic as Dashboard)
    // The dashboard checks: https://jahangirnrl.github.io/nrl/firmware/ROOM_2/version.txt
    String versionCheckUrl = "https://jahangirnrl.github.io/nrl/firmware/" + roomNameMap + "/version.txt";
    
    Serial.println("Checking for new version string...");
    http.begin(versionCheckUrl);
    int httpCode = http.GET();
    
    if (httpCode == 200) {
      String newVersion = http.getString();
      newVersion.trim(); // Remove whitespace/newlines
      
      // 2. Construct the Download URL using the Chip ID (9255912) and new Version
      // Example result: https://jahangirnrl.github.io/nrl/firmware/9255912_3.4.0.bin
      String downloadUrl = "https://jahangirnrl.github.io/nrl/firmware/9255912_" + newVersion + ".bin";
      
      Serial.print("Target Firmware: "); Serial.println(newVersion);
      Serial.print("Download URL: "); Serial.println(downloadUrl);
      
      // 3. Update Status in Firebase
      Firebase.RTDB.setString(&fbdo, "HOME/ROOM_2/updateStatus", "downloading");

      // 4. Perform the Update
      t_httpUpdate_return ret = ESPhttpUpdate.update(downloadUrl);

      switch (ret) {
        case HTTP_UPDATE_FAILED:
          Serial.printf("HTTP_UPDATE_FAILED Error (%d): %s\n", ESPhttpUpdate.getLastError(), ESPhttpUpdate.getLastErrorString().c_str());
          Firebase.RTDB.setString(&fbdo, "HOME/ROOM_2/updateStatus", "failed");
          playErrorBeep();
          break;

        case HTTP_UPDATE_NO_UPDATES:
          Serial.println("HTTP_UPDATE_NO_UPDATES");
          Firebase.RTDB.setString(&fbdo, "HOME/ROOM_2/updateStatus", "no_updates");
          break;

        case HTTP_UPDATE_OK:
          Serial.println("HTTP_UPDATE_OK");
          // The device will restart automatically here
          break;
      }
    } else {
      Serial.print("Failed to fetch version.txt. HTTP Code: "); Serial.println(httpCode);
      playErrorBeep();
    }
    http.end();
  }
  
  // Reset request flag
  updateRequest = false;
  Firebase.RTDB.setBool(&fbdo, "HOME/ROOM_2/updateRequest", false); 
}


