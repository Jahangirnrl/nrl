//----------------------3: FUNCTION STAT --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
void syncRelaysWithRTDB() {  if (!Firebase.ready()) {    Serial.println("Firebase not ready for relay sync");   
return;  }
  
  Serial.println("🔁 Syncing relay states with RTDB...");
  
  for (int i = 0; i < 4; i++) {    if (Firebase.RTDB.getBool(&fbdo, RrelayPath[i].c_str())) {
      bool cloudState = fbdo.boolData();
      
      // Only update if state is different
      if (relayState[i] != cloudState) {
        relayState[i] = cloudState;
        int pin = (i==0)?RELAY1_PIN:(i==1)?RELAY2_PIN:(i==2)?RELAY3_PIN:RELAY4_PIN;
        digitalWrite(pin, relayState[i] ? LOW : HIGH);
        Serial.printf("  Relay%d synced to: %s\n", i+1, relayState[i]?"ON":"OFF");
        
        // Play sync beep for each relay that was updated
        if (beepEnabled && initialSyncCompleted) {          playSyncBeep(i + 1);        }      }    } 
    else {  Serial.printf("  Failed to read Relay%d state: %s\n", i+1, fbdo.errorReason().c_str());    } delay(100); }
  
  if (!initialSyncCompleted) {  initialSyncCompleted = true;  Serial.println("✅ Initial relay sync completed");   
  playCompletionBeep(); }
}
//----------------------3: FUNCTION END --------------------------------------------------------------------------------------------------------------------------------------------------------------------------


//----------------------4: FUNCTION START --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
void streamCallback(FirebaseStream data) {
  Serial.printf("Stream update: %s = %s\n", data.dataPath().c_str(), data.stringData().c_str());

  for (int i=0;i<4;i++) {
    // Check if the update is for one of the relays
    // Note: dataPath() will return the full path relative to the stream root,
    // e.g., if stream is HOME/ROOM_2, dataPath will be /relay1
    if (data.dataPath().endsWith(RrelayPath[i].substring(RrelayPath[i].lastIndexOf('/')))) {
      bool newState = data.boolData();
      if (relayState[i] != newState) {
        relayState[i] = newState;
        int pin = (i==0)?RELAY1_PIN:(i==1)?RELAY2_PIN:(i==2)?RELAY3_PIN:RELAY4_PIN;
        digitalWrite(pin, relayState[i] ? LOW : HIGH);  playRelayBeep();
        Serial.printf("Relay%d set from cloud: %s\n", i+1, relayState[i]?"ON":"OFF"); } } }


  // ... [Keep your existing Beep/Lock logic here] ...

  // ADD THIS NEW BLOCK MATCHING THE DASHBOARD LOGIC:
  if (data.dataPath() == "/updateRequest") {  bool req = data.boolData();    if (req) {      Serial.println("📲 Firmware Update Requested via Dashboard!");      updateRequest = true; playSettingChangeBeep();    }  }
  
  // Check for beep setting changes
  if (data.dataPath() == "/settings/beepEnabled") {    bool newBeepState = data.boolData();    if (lastBeepState != newBeepState) {      beepEnabled = newBeepState;      lastBeepState = newBeepState;
      Serial.printf("Beep %s\n", beepEnabled ? "ENABLED" : "DISABLED"); playSettingChangeBeep();  }   }

  // NEW: Check for IR lock setting changes
  if (data.dataPath() == "/settings/ir_lock") {    bool newIrLockState = data.boolData();    if (lastIrLockState != newIrLockState) {      irLockEnabled = newIrLockState;      lastIrLockState = newIrLockState;
      Serial.printf("IR Lock %s\n", irLockEnabled ? "LOCKED" : "UNLOCKED"); playSettingChangeBeep();  }   }

  // NEW: Check for button lock setting changes
  if (data.dataPath() == "/settings/button_lock") {    bool newButtonLockState = data.boolData();    if (lastButtonLockState != newButtonLockState) {      buttonLockEnabled = newButtonLockState;      lastButtonLockState = newButtonLockState;
      Serial.printf("Button Lock %s\n", buttonLockEnabled ? "LOCKED" : "UNLOCKED"); playSettingChangeBeep();  }   }

  // NEW: Check for automation setting changes
  if (data.dataPath() == "/automation/enabled") {    bool newAutomationState = data.boolData();    if (lastAutomationState != newAutomationState) {      automationEnabled = newAutomationState;      lastAutomationState = newAutomationState;
      Serial.printf("Automation %s\n", automationEnabled ? "ENABLED" : "DISABLED"); playSettingChangeBeep();  }   }   }

void streamTimeoutCallback(bool timeout) {  if (timeout) { Serial.println("Stream timed out, reconnecting...");  } }

//----------------------4: FUNCTION END --------------------------------------------------------------------------------------------------------------------------------------------------------------------------

//----------------------5: FUNCTION START --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
void initFirebase() {
  config.api_key = API_KEY;
  auth.user.email = USER_EMAIL;
  auth.user.password = USER_PASSWORD;
  config.database_url = DATABASE_URL;

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
  config.token_status_callback = tokenStatusCallback; // optional but useful for debugging

  // Setup stream to listen for cloud changes
  if (!Firebase.RTDB.beginStream(&stream, "HOME/ROOM_2")) {
    Serial.printf("Stream begin error: %s\n", stream.errorReason().c_str() );  } else {  }
  Firebase.RTDB.setStreamCallback(&stream, streamCallback, streamTimeoutCallback);
}
//----------------------5: FUNCTION END --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Fix: replacement for timegm()
time_t makeTimeUTC(struct tm *t) {  char *tz = getenv("TZ");  setenv("TZ", "", 1);   tzset();  time_t result = mktime(t); if (tz) setenv("TZ", tz, 1);  else unsetenv("TZ");  tzset();  return result;  }

