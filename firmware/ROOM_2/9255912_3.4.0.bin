void updateDeviceStatus() {
  if (WiFi.status() == WL_CONNECTED && Firebase.ready()) {    struct tm timeinfo;    if (getLocalTime(&timeinfo)) {      char buf[25];
      //strftime(buf, sizeof(buf), "%Y-%m-%d | %H:%M:%S", &timeinfo);
