// NEW: Temperature-based automation execution
void executeTemperatureSchedule(int scheduleId, int relay, String schedulePath) {
  if (Firebase.ready()) {
    // Get current temperature from RTDB
    if (Firebase.RTDB.getString(&fbdo, "HOME/ROOM_2/weather/temperature")) {
      float currentTemp = fbdo.stringData().toFloat(); Serial.print("C_temp :  "); Serial.print(currentTemp); 
      
      // Get temperature condition and value
      if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/condition").c_str())) {
        String condition = fbdo.stringData();
        
        if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/value").c_str())) {
          float targetTemp = fbdo.stringData().toFloat(); Serial.print(" & T_temp :  "); Serial.println(targetTemp); 
          
          // Get action (ON/OFF)
          if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/action").c_str())) {
            bool action = fbdo.boolData();
            bool shouldExecute = false;
            
            // Check temperature condition
            if (condition == ">") {              shouldExecute = (currentTemp > targetTemp);  } 
       else if (condition == "<") {              shouldExecute = (currentTemp < targetTemp);  }
            
            if (shouldExecute) {
              // Check if we already executed this recently (within last 5 minutes)
              unsigned long currentTime = millis();
              
              if (currentTime - lastTempExecution[scheduleId] > 30000) { // 5 minutes 300000
                setRelayNB(relay, action);
                Serial.printf("🤖 Schedule%d: Relay%d %s (Temp: %.1f°C %s %.1f°C)\n", 
                              scheduleId, relay + 1, action ? "ON" : "OFF", 
                              currentTemp, condition.c_str(), targetTemp);
                //  playAutomationBeep();
                
                // Update last execution time
                lastTempExecution[scheduleId] = currentTime;
                Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                        "Temp: " + String(currentTemp, 1) + "°C");
              }
            }
          }
        }
      }
    } else {
      Serial.printf("  ⚠ Schedule%d: Failed to read temperature data\n", scheduleId);
    }
  }
}

void executeTimerSchedule(int scheduleId, int relay, String schedulePath) {
  if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/enabled").c_str())) {
    bool trigger = fbdo.boolData();
    
    if (trigger) {
      // Get duration in minutes
      if (Firebase.RTDB.getInt(&fbdo, (schedulePath + "/duration").c_str())) {
        int duration = fbdo.intData();
        
        // Get action (ON/OFF) from RTDB
        if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/action").c_str())) {
          bool action = fbdo.boolData();
          
          if (duration > 0 && duration <= 1440) { // Validate duration (1 min to 24 hours)
            if (action) {
              // ON Timer: Turn relay ON for specified duration, then OFF
              startOnTimer(scheduleId, relay, duration);
              setRelayNB(relay, true); // Turn ON immediately
              
              Serial.printf("🤖 Schedule%d: Relay%d ON Timer started for %d minutes\n", 
                            scheduleId, relay + 1, duration);
              
              Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                      "ON Timer: " + String(duration) + "min");
            } else {
              // OFF Timer: Turn relay OFF for specified duration, then ON
              startOffTimer(scheduleId, relay, duration);
              setRelayNB(relay, false); // Turn OFF immediately
              
              Serial.printf("🤖 Schedule%d: Relay%d OFF Timer started for %d minutes\n", 
                            scheduleId, relay + 1, duration);
              
              Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                      "OFF Timer: " + String(duration) + "min");
            }
            
            // Reset trigger in Firebase
            Firebase.RTDB.setBool(&fbdo, (schedulePath + "/enabled").c_str(), false);
            
          } else {
            Serial.printf("❌ Invalid duration for Schedule%d: %d minutes\n", scheduleId, duration);
          }
        } else {
          Serial.printf("❌ Failed to read action for Schedule%d\n", scheduleId);
        }
      } else {
        Serial.printf("❌ Failed to read duration for Schedule%d\n", scheduleId);
      }
    }
  }
}

// -------------------- IR --------------------
#define IR_CODE_RELAY1      0x6BC6597B  // SINGER REMOTE 1      KEY       
#define IR_CODE_RELAY2      0x735B797E  // SINGER REMOTE 2      KEY       
#define IR_CODE_RELAY3      0x1EC81DBF  // SINGER REMOTE 3      KEY       
#define IR_CODE_RELAY4      0x450753D6  // SINGER REMOTE 4      KEY       
#define IR_CODE_mute        0x92DFD41F  // SINGER REMOTE MUTE   KEY       
#define IR_CODE_ir_lock     0xB8E7B4FE  // SINGER REMOTE OK     KEY         IR lock code
#define IR_CODE_button_lock 0xCD9141E   // SINGER REMOTE MENU   KEY         NEW: Replace with your actual button lock IR code

// List of valid IR codes - ONLY these will be accepted
const unsigned long validIRCodes[] = {
  IR_CODE_RELAY1, IR_CODE_RELAY2, IR_CODE_RELAY3, IR_CODE_RELAY4,
  IR_CODE_mute, IR_CODE_ir_lock, IR_CODE_button_lock,
  2534850111, 1033561079, 1635910171, 2351064443,  // Mini MP3 remote codes
  //0x4CB0FADC, 0x49B0F626, 0xA36D8B6A, 0xBFBD49E5,0x4AB0F7B5, 0x5CDE72CA,  0xE93C8432, 0x70B8505B, 0xFDAC0153,   // SOMTHING ELSE MAY BE CAMERA AND SUN THIS LINE FOR IGNORE AND ALSO BEEP IGNORE
};

const int numValidCodes = sizeof(validIRCodes) / sizeof(validIRCodes[0]);
bool      isValidIRCode(unsigned long code) {  for (int i = 0; i < numValidCodes; i++) {    if (code == validIRCodes[i]) {      return true;    }  }  return false;  }

void IR_Loop() {
    if (irrecv.decode(&results)) {
    unsigned long value = results.value;
    Serial.print("IR Code  : "); Serial.println(value, HEX); delay(200);// Use HEX for consistent logging
    
    if (!isValidIRCode(value)) {  Serial.println("❌ UNKNOWN IR CODE - BLOCKED");  
    //playBlockedBeep();      
    irrecv.resume();      delay(450);      return;    }
    if (irLockEnabled && value != IR_CODE_ir_lock && value != IR_CODE_button_lock) { Serial.println("🔒 IR LOCKED - Command ignored"); 
    playBlockedBeep(); irrecv.resume(); delay(450); return; }
    
 // if (value == 0x4CB0FADC || 0x49B0F626 || 0xA36D8B6A || 0xBFBD49E5 || 0x4AB0F7B5 || 0x5CDE72CA || 0xFDAC0153) {Serial.print("\nCam Signal Catch\n");}  // its disturbance signal from camera night vision ir.
    
    // Check against defined codes (singer remote)
    if      (value == IR_CODE_RELAY1) setRelay(0,!relayState[0]);
    else if (value == IR_CODE_RELAY2) setRelay(1,!relayState[1]);
    else if (value == IR_CODE_RELAY3) setRelay(2,!relayState[2]);
    else if (value == IR_CODE_RELAY4) setRelay(3,!relayState[3]);
    else if (value == IR_CODE_mute  ){IrBeepSt();               } 
    else if (value == IR_CODE_ir_lock  ){toggleIrLock();           }  // Toggle IR lock only
    else if (value == IR_CODE_button_lock  ){toggleButtonLock();       }  // NEW: Toggle button lock only
    
    // Check against other codes (mini mp3 white remote)
    else if (value == 2534850111) setRelay(0,!relayState[0]);
    else if (value == 1033561079) setRelay(1,!relayState[1]);
    else if (value == 1635910171) setRelay(2,!relayState[2]);
    else if (value == 2351064443) setRelay(3,!relayState[3]);
    irrecv.resume();  delay(450);
  }
}

void IrBeepSt(){  bool beepst=true;
  if(beepEnabled == 0) (beepst=true); else if (beepEnabled == 1) {beepst=false;   playRelayBeep();}
  if (WiFi.status() == WL_CONNECTED && Firebase.ready()) { Firebase.RTDB.setBool(&fbdo, "/HOME/ROOM_2/settings/beepEnabled", beepst); }  }

void toggleIrLock() {  bool newIrLockState = !irLockEnabled;
  
  if (WiFi.status() == WL_CONNECTED && Firebase.ready()) {     Firebase.RTDB.setBool(&fbdo, "/HOME/ROOM_2/settings/ir_lock", newIrLockState);  }
  
  irLockEnabled = newIrLockState;
  lastIrLockState = newIrLockState;
  
  Serial.printf("IR %s via remote\n", irLockEnabled ? "LOCKED" : "UNLOCKED");
  
  if (irLockEnabled) {    playLockBeep();  } else {    playUnlockBeep();  } }


// NEW: Toggle button lock function
void toggleButtonLock() {  bool newButtonLockState = !buttonLockEnabled;
    if (WiFi.status() == WL_CONNECTED && Firebase.ready()) { Firebase.RTDB.setBool(&fbdo, "/HOME/ROOM_2/settings/button_lock", newButtonLockState);  }
  
  buttonLockEnabled = newButtonLockState;
  lastButtonLockState = newButtonLockState;
  
  Serial.printf("Button Lock %s via button 4 long press\n", buttonLockEnabled ? "LOCKED" : "UNLOCKED");
  
  // Play appropriate beep
  if (buttonLockEnabled) {    playLockBeep();  } else {    playUnlockBeep();  } }

// -------------------- BUTTON --------------------
void BTN_Loop() { 
  int bPins[4] = {BTN1_PIN, BTN2_PIN, BTN3_PIN, BTN4_PIN};  
  unsigned long currentMillis = millis();
  
  for (int i = 0; i < 4; i++) {
    bool currentState = digitalRead(bPins[i]);
    
    // Check for button 4 long press (for button lock toggle)
    if (i == 3) { // Button 4
      if (currentState == LOW && lastButtonState[i] == HIGH) {
        // Button 4 pressed - start timing
        button4PressTime = currentMillis;
        button4Pressed = true;
      }
      else if (currentState == HIGH && lastButtonState[i] == LOW) {
        // Button 4 released
        if (button4Pressed && (currentMillis - button4PressTime < LONG_PRESS_DURATION)) {
          // Short press - normal relay toggle (if button lock is not enabled)
          if (!buttonLockEnabled) {
            setRelay(i, !relayState[i]);
          } else {
            Serial.println("🔒 Button Locked - Button 4 command ignored");
            playBlockedBeep();
          }
        }
        button4Pressed = false;
      }
      
      // Check for long press completion
      if (button4Pressed && (currentMillis - button4PressTime >= LONG_PRESS_DURATION)) {
        // Long press detected - toggle button lock
        toggleButtonLock();
        button4Pressed = false; // Reset to prevent multiple triggers
        delay(250); // Debounce delay
      }
    }
    else { // Buttons 1-3
      if (lastButtonState[i] == HIGH && currentState == LOW) {
        // Normal button press for buttons 1-3
        if (!buttonLockEnabled) {
          setRelay(i, !relayState[i]);
          delay(250);
        } else {
          Serial.printf("🔒 Button Locked - Button %d command ignored\n", i + 1);
          playBlockedBeep();
        }
      }
    }
    
    lastButtonState[i] = currentState;
  }
}

// -------------------- SUNRISE/SUNSET --------------------
void fetchSunriseSunset() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    Serial.printf("\nGetting Sunset and Sunrise info from API...\n");
    // Using formatted=0 for ISO 8601 UTC time
    http.begin("http://api.sunrise-sunset.org/json?lat=23.8103&lng=90.4125&formatted=0"); // Dhaka
    int httpCode = http.GET();
    if (httpCode == 200) {
      String payload = http.getString();
      StaticJsonDocument<1024> doc;
      DeserializationError error = deserializeJson(doc, payload);

    if (!error) {
      const char* sunriseStr = doc["results"]["sunrise"];
      const char* sunsetStr  = doc["results"]["sunset"];
      struct tm tm = {};
      const int GTM_OFFSET_HOURS = 6; // GMT+6 for Dhaka

      // ---- Sunrise ----
      if (strptime(sunriseStr, "%Y-%m-%dT%H:%M:%S", &tm)) {          time_t t = makeTimeUTC(&tm); sunriseTime = t + (GTM_OFFSET_HOURS * 3600); // Convert UTC to local GMT+6
        char buf[20];          strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&sunriseTime));   Firebase.RTDB.setString(&fbdo, "/HOME/ROOM_2/sunrise", buf);   Serial.printf("Sunrise local: %s\n", buf);        }

      // ---- Sunset ----
      if (strptime(sunsetStr, "%Y-%m-%dT%H:%M:%S", &tm)) {          time_t t = makeTimeUTC(&tm); sunsetTime = t + (GTM_OFFSET_HOURS * 3600); // Convert UTC to local GMT+6
        char buf[20];          strftime(buf, sizeof(buf), "%H:%M:%S", localtime(&sunsetTime));   Firebase.RTDB.setString(&fbdo, "HOME/ROOM_2/sunset", buf);    Serial.printf("Sunset  local: %s\n", buf); }   }  } 
         else {      Serial.printf("HTTP error fetching sun info: %d\n", httpCode);      playErrorBeep();    }    http.end();      }}
  
//-----------------------------------------------------------------------

// Attempts to refresh sun data shortly after midnight (00:02)

void dailySunRefresh() {  struct tm timeinfo;  if (!getLocalTime(&timeinfo)) return;
if (sunriseTime      == 0 || sunsetTime      == 0) {  if (millis() - lastSunRefresh > 3000) {      fetchSunriseSunset();      lastSunRefresh = millis();    }  }
if (timeinfo.tm_hour == 0 && timeinfo.tm_min == 2) {  if (millis() - lastSunRefresh > 3000) {      fetchSunriseSunset();      lastSunRefresh = millis();    }  }   // Check if it's 12:02 AM
}

// -------------------- TIME INITIALIZATION --------------------
void initTime() {
  const long gmtOffset_sec = 6 * 3600; // GMT+6
  const int daylightOffset_sec = 0;

  // Set timezone and start NTP synchronization
  configTime(gmtOffset_sec, daylightOffset_sec, "pool.ntp.org", "time.google.com");

  struct tm timeinfo;  int retry = 0;
  while (!getLocalTime(&timeinfo) && retry < 5) {   Serial.println("Waiting for NTP sync...");
  delay(1000);    retry++;  }
  if (retry < 10) {    Serial.printf("\n✅ NTP time synced: %s\n", asctime(&timeinfo));  } else {   Serial.println("⚠ Failed to obtain NTP time || Restrating...System "); 
    playErrorBeep(); delay(530); ESP.restart(); }  
 }

// Timer helper functions
void startOnTimer(int scheduleId, int relay, int durationMinutes) {
  for (int i = 0; i < 10; i++) {
    if (!activeTimers[i].active) {
      activeTimers[i].scheduleId = scheduleId;
      activeTimers[i].relay = relay;
      activeTimers[i].endTime = millis() + (durationMinutes * 60000UL);
      activeTimers[i].active = true;
      activeTimers[i].isOnTimer = true;
      activeTimers[i].originalState = relayState[relay]; // Store current state
      activeTimerCount++;
      
      Serial.printf("⏰ ON Timer started: Schedule%d, Relay%d, %d minutes\n", 
                    scheduleId, relay + 1, durationMinutes);
      return;
    }
  }
  Serial.println("❌ No available timer slots for ON timer");
}

void startOffTimer(int scheduleId, int relay, int durationMinutes) {
  for (int i = 0; i < 10; i++) {
    if (!activeTimers[i].active) {
      activeTimers[i].scheduleId = scheduleId;
      activeTimers[i].relay = relay;
      activeTimers[i].endTime = millis() + (durationMinutes * 60000UL);
      activeTimers[i].active = true;
      activeTimers[i].isOnTimer = false;
      activeTimers[i].originalState = relayState[relay]; // Store current state
      activeTimerCount++;
      
      Serial.printf("⏰ OFF Timer started: Schedule%d, Relay%d, %d minutes\n", 
                    scheduleId, relay + 1, durationMinutes);
      return;
    }
  }
  Serial.println("❌ No available timer slots for OFF timer");
}

void checkActiveTimers() {
  unsigned long currentTime = millis();
  
  for (int i = 0; i < 10; i++) {
    if (activeTimers[i].active && currentTime >= activeTimers[i].endTime) {
      // Timer expired
      if (activeTimers[i].isOnTimer) {
        // ON Timer expired - turn OFF the relay
        setRelayNB(activeTimers[i].relay, false);
        Serial.printf("⏰ ON Timer expired: Schedule%d, Relay%d OFF\n", 
                      activeTimers[i].scheduleId, activeTimers[i].relay + 1);
        
        Firebase.RTDB.setString(&fbdo, 
          ("HOME/ROOM_2/automation/schedule" + String(activeTimers[i].scheduleId) + "/lastRun").c_str(), 
          "ON Timer completed: Relay OFF");
      } else {
        // OFF Timer expired - restore to original state
        setRelayNB(activeTimers[i].relay, activeTimers[i].originalState);
        Serial.printf("⏰ OFF Timer expired: Schedule%d, Relay%d restored to %s\n", 
                      activeTimers[i].scheduleId, activeTimers[i].relay + 1,
                      activeTimers[i].originalState ? "ON" : "OFF");
        
        Firebase.RTDB.setString(&fbdo, 
          ("HOME/ROOM_2/automation/schedule" + String(activeTimers[i].scheduleId) + "/lastRun").c_str(), 
          "OFF Timer completed: Relay restored");
      }
      
      // Clear the timer
      activeTimers[i].active = false;
      activeTimerCount--;
    }
  }
}

void initTimers() {
  for (int i = 0; i < 10; i++) {
    activeTimers[i].active = false;
  }
  activeTimerCount = 0;
}

//timer
//------------------------------->> FUNCTION <<-----------------------------------------------------------------------------------------------------//                          
void ED_Loop(){  unsigned long currentMillis1 = millis();
             if (currentMillis1 - previousMillis1 >= intervale) {    previousMillis1 = currentMillis1;    currentCount++;    countUpdates++;
                 //Serial.print("Current count: ");    Serial.print(currentCount);    Serial.print(" - Update No: ");    Serial.print(countUpdates);    
                 measureAndCheckDelay();  }    }

void measureAndCheckDelay() {  static unsigned long lastUpdateTime = 0; // Static variable to persist across function calls
  
  unsigned long now = millis();  if (lastUpdateTime == 0) {    lastUpdateTime = now;    return; }
  unsigned long timeDifference = now - lastUpdateTime;
  
  // Check if the time difference exceeds the delay threshold (20 seconds)
      if (timeDifference > delayThreshold) {  d_count++; Serial.print("Delay Detected Count:  "); Serial.print(d_count); Serial.print("   "); 
      WiFi.disconnect(); delay(1000); // initWiFi(); 
      delay(1000); if (d_count > 5 ) {
                                              Serial.println("\n*** DELAY DETECTED! 6 TIMES***ITS HUZE SO....");  Serial.println("System Re-Starting..."); 
                                              delay(1000); ESP.restart();    }  else{}  }
else {  // Serial.print("      Normal update. Time difference: ");    Serial.print(timeDifference);-    Serial.println(" milliseconds.");  
         }  lastUpdateTime = now;  }


