  if (Firebase.ready()) {    if (Firebase.RTDB.getBool(&fbdo, "HOME/ROOM_2/settings/beepEnabled")) {      bool newBeepState = fbdo.boolData();
      if (lastBeepState != newBeepState) {        beepEnabled = newBeepState;        lastBeepState = newBeepState;
        Serial.printf("Beep setting updated: %s\n", beepEnabled ? "ENABLED" : "DISABLED");    playSettingChangeBeep();         // Play confirmation beep
      }    }  }}

