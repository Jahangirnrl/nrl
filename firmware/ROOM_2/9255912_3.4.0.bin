// Writes device info (IP, MAC, SSID, Model) once on boot.
void updateDeviceInfo() {
  if (WiFi.status() == WL_CONNECTED && Firebase.ready()) {
      Serial.println("Writing device info to RTDB.");
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/ssid",            WiFi.SSID());
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/ip",              WiFi.localIP().toString());
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/mac",             WiFi.macAddress());
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/ChipID",          chipId);                              // getChipId
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/model",           ESP.getChipModel());                  // CORRECTION: Use getChipModel() instead of the deprecated getChipId()
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/device/firmwareVersion", FW_VS);                               // Write firmware version to the device path
    Firebase.RTDB.setBool   (&fbdo, "HOME/ROOM_2/settings/beepEnabled",   beepEnabled);                         // Set initial beep state
    Firebase.RTDB.setBool   (&fbdo, "HOME/ROOM_2/settings/ir_lock",       irLockEnabled);                       // Set initial IR lock state - CORRECTED: false=unlocked, true=locked
    Firebase.RTDB.setBool   (&fbdo, "HOME/ROOM_2/settings/button_lock",   buttonLockEnabled);                   // Set initial button lock state - NEW: false=unlocked, true=locked
    Firebase.RTDB.setBool   (&fbdo, "HOME/ROOM_2/automation/enabled",     automationEnabled);                   // Set initial automation state
    Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/online", "true");                                              // Explicitly set online=true here, and let the dashboard handle disconnects
  }
}
