void playBeep(int frequency, int duration)  {   if (!beepEnabled) return; tone(BUZZER_PIN, frequency, duration);  delay(duration);  noTone(BUZZER_PIN);}
void playRelayBeep()                        {   playBeep(2000, 100);}                                                                        // Short beep for relay operations
void playSettingChangeBeep()                {   playBeep(1500, 80);   delay(50);  playBeep(1500, 80);  }                                      // Double beep for setting changes
void playStartupBeep()                      {   playBeep(1000, 100);  delay(50);  playBeep(1500, 100);  delay(50);  playBeep(2000, 150);  }  // Startup sequence
void playErrorBeep()                        {   playBeep(500, 200);  delay(100);  playBeep(500, 200); }                                      // Error beep sequence
void playSyncBeep(int relayNumber)          {   for (int i = 0; i < relayNumber; i++) {    playBeep(1200, 50);    delay(80);  } }            // Beep pattern to indicate which relay was synced
void playCompletionBeep()                   {   playBeep(1500, 100);  delay(80);  playBeep(1800, 100);  delay(80);  playBeep(2100, 150);  }  // Completion beep sequence
void playLockBeep()                         {   playBeep(1000, 100);  delay(100);  playBeep(1000, 100);  }                                  // NEW: Lock beep sequence
void playUnlockBeep()                       {   playBeep(1500, 100);  delay(50);  playBeep(2000, 150);  }                                  // NEW: Unlock beep sequence
void playBlockedBeep()                      {   playBeep(300, 200);  delay(100);  playBeep(300, 200);  }                                   // NEW: Blocked signal beep
void playAutomationBeep()                   {   playBeep(1800, 80);  delay(60);  playBeep(1800, 80);  delay(60);  playBeep(1800, 80);  }   // NEW: Automation execution beep

