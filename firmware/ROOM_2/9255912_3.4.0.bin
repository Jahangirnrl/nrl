      }
      
      // Set sunset to today's date
      sunset_tm.tm_year = timeinfo.tm_year;
      sunset_tm.tm_mon = timeinfo.tm_mon;
      sunset_tm.tm_mday = timeinfo.tm_mday;
      sunset_tm.tm_isdst = timeinfo.tm_isdst;
      
      // Apply offset
      sunset_tm.tm_min += offset;
      time_t scheduledTime = mktime(&sunset_tm); // Normalize after offset
      
      time_t now;
      time(&now);
      
      // Debug info
      Serial.printf("Schedule%d: Sunset: %s, Offset: %d min, ", scheduleId, sunsetStr.c_str(), offset);
      
      char scheduledStr[9];
      strftime(scheduledStr, sizeof(scheduledStr), "%H:%M:%S", &sunset_tm);
      Serial.printf("Scheduled: %s, ", scheduledStr);
      
      char nowStr[9];
      strftime(nowStr, sizeof(nowStr), "%H:%M:%S", &timeinfo);
      Serial.printf("Current: %s\n", nowStr);
      
      // Check if current time matches scheduled time (within 60 seconds)
      if (now >= scheduledTime && now < scheduledTime + 60) {
        // Get action (ON/OFF)
        if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/action").c_str())) {
          bool action = fbdo.boolData();
          setRelayNB(relay, action);
          
          Serial.printf("🤖 Schedule%d: Relay%d %s at Sunset%s\n", 
                        scheduleId, relay + 1, action ? "ON" : "OFF",
                        offset != 0 ? (offset > 0 ? " +" : " ") + String(offset) + "min" : "");
          
          // Update last execution time
          Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                  "Sunset" + String(offset != 0 ? (offset > 0 ? " +" : " ") + String(offset) + "min" : "") + ": " + String(scheduledStr));
        }
      }
    } else {
      Serial.printf("  ⚠ Schedule%d: Invalid sunset time format\n", scheduleId);
    }
  } else {
    Serial.printf("  ⚠ Schedule%d: Failed to read sunset time\n", scheduleId);
  }
}

