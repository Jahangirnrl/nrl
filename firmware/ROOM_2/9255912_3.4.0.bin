void OTA_S            (){ ArduinoOTA
       .onStart    ([](){ String type; if (ArduinoOTA.getCommand() == U_FLASH) type = "sketch"; else type = "filesystem"; })
       .onEnd      ([](){ Serial.println("\nEnd"); })
       .onProgress ([]  ( unsigned int progress, unsigned int total) {Serial.printf("Progress: %u%%\r", (progress / (total / 100)));    })
       .onError    ([]  ( ota_error_t error)       {Serial.printf ("Error[%u]: ", error);
                                                if (error == OTA_AUTH_ERROR)          Serial.println("Auth Failed"       );
                                           else if (error == OTA_BEGIN_ERROR)         Serial.println("Begin Failed"      );
                                           else if (error == OTA_CONNECT_ERROR)        Serial.println("Connect Failed"    );
                                           else if (error == OTA_RECEIVE_ERROR)        Serial.println("Receive Failed"    );
                                           else if (error == OTA_END_ERROR)            Serial.println("End Failed"); }    );
                                                    ArduinoOTA.begin();                                              }

void OTA_L        ()  { OTA_S(); ArduinoOTA.handle();                                                                                                               }
void host_name    ()  { String hostname = "ROOM_2"; WiFi.setHostname(hostname.c_str());                                                                     }
void wifi_stl     ()  { float val = (exp(sin(millis()/5000.0 * PI)) - 0.368) * 108.0; analogWrite(wl, val);                                                         }
void wifi_st      ()  { unsigned long CT = millis();  if (CT - PT    >= ET  )   { Serial.println("Connecting WiFi...");                                PT  = CT;  } }  //  WiFi Status Print in Loop @ 30 sec delay
void wifi_st2     ()  { unsigned long CT = millis();  if (CT - PT1   >= ET1 )   { count++;  Serial.println(count);                                     PT1 = CT;  } }  //  WiFi Status Print in Loop @ 30 sec delay
void get_data     ()  { unsigned long CT = millis();  if (CT - PT2   >= ET2 )   {                                  PT2 = CT;  } }  //  WiFi Status Print in Loop @ 30 sec delay
void wifi_st3     ()  { if(count2<1){Serial.println("WiFi Connected yeh.! ");  Serial.println("System Main Process Started.. ");  count2++; } }  //  1 Time After wifi connection
void L_Blink      ()  {                 digitalWrite(wl, HIGH); delay(80); digitalWrite(wl, LOW);   delay(90);                                                      }
void dht_loop     ()  { float h = dht.readHumidity();  float t = dht.readTemperature();  float f = dht.readTemperature(true); // Read temperature in Fahrenheit
                        if (isnan(h) || isnan(t) || isnan(f)) { Serial.println(F("Failed to read from DHT sensor!")); return;  }
                        Serial.print(F("Humidity: "));  Serial.print(h);  Serial.print(F("%  Temperature: "));  Serial.print(t);  Serial.print(F("°C  ~  "));  Serial.print(f);  Serial.println(F("°F"));
                        if (WiFi.status() == WL_CONNECTED && Firebase.ready()) { Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/weather/temperature", (t)); Firebase.RTDB.setString (&fbdo, "HOME/ROOM_2/weather/humidity", (h)); } }
void L_on         ()  { digitalWrite(wl, HIGH);                                                                                                                     }
void L_off        ()  { digitalWrite(wl, LOW );                                                                                                                     }

void Main_Loopp   ()  { if (chipId == vChId) { Serial.print ("Authentication Check  :   PASSED\n"); delay(200);}  else{ while (chipId != vChId) {C_FAILED(); } } }
void Main_Loop    ()  { if (chipId == vChId) { C_PASSED(); }  else{ while (chipId != 9255912) {C_FAILED(); } } }
void C_FAILED     ()  { playErrorBeep(); Serial.print("\nAuthetication Failled. Please Contact With Admin: jahangir.nrl@gmail.com or +8801911132254 (: Thank you."); delay (10*1000);}
void C_PASSED     ()  {    if (WiFi.status() != WL_CONNECTED)   { delay(300); count2=0;
                        while (WiFi.status() != WL_CONNECTED)   { L_Blink(); con(); delay(300);  wifi_st(); set_server(); IR_Loop();  BTN_Loop();  ED_Loop();   } }
                        while (WiFi.status() == WL_CONNECTED)   { ALL_LOOP(); digitalWrite(wl, LOW);  set_server(); OTA_L();                                    } }
                        



// CT= Current Time, PT= Previous Time, ET= Event Time
void esp_info     ()  { for(int i=0; i<17; i=i+8) {    chipId |= ((ESP.getEfuseMac() >> (40 - i)) & 0xff) << i;  }
                        Serial.print  ("Chip ID               :   "); Serial.println(chipId);
                        Serial.printf ("ESP32 Chip model      :   %s Rev %d\n", ESP.getChipModel(), ESP.getChipRevision());  
                        Serial.print  ("ESP Board MAC Address :   ");   String mac = WiFi.macAddress(); Serial.print(mac); }
void esp_info_s   ()  { for(int i=0; i<17; i=i+8) {    chipId |= ((ESP.getEfuseMac() >> (40 - i)) & 0xff) << i;  } }                        
                        
void firmware_up  ()  { Serial.println("Searching for New Firmware Update File.."); t_httpUpdate_return ret = ESPhttpUpdate.update(f_link);

//                      t_httpUpdate_return ret = ESPhttpUpdate.update("https://jahangirnrl.github.io/nrl/firmware/9255912_V_4.bin");
                        
    switch(ret)       { case HTTP_UPDATE_FAILED:      Serial.printf ("\nHTTP_UPDATE_FAILD Error (%d): %s", ESPhttpUpdate.getLastError(), ESPhttpUpdate.getLastErrorString().c_str()); break;
                        case HTTP_UPDATE_NO_UPDATES:  Serial.println("\nHTTP_UPDATE_NO_UPDATES"); break;
                        case HTTP_UPDATE_OK:          Serial.println("\nHTTP_UPDATE_OK");         break;                                        } }

void wifi_con     ()  { WiFi.setHostname(new_hostname); set_server(); if (WiFi.status() != WL_CONNECTED) {WiFi.begin(user_wifi.ssid, user_wifi.password); delay(1000); } }

void con          ()  { if (cap==0){  wifi_con(); }         }                                              


void fb_loop      ()  {                        
                          // 1. Heartbeat Pulse (5 seconds) - CRITICAL for Dashboard Online Status
                          if    (millis() - lastUptimeUpdate > UPTIME_INTERVAL) { //Serial.print("UpTime    : ");  Serial.println(getUptime()); 
                          updateUptimePulse(); lastUptimeUpdate = millis();}
                        
                          // 2. Full Status Update (120 seconds / 2 minutes) - Less frequent
                          if    (millis() - lastStatusUpdate > STATUS_INTERVAL) { dht_loop();  updateDeviceStatus(); lastStatusUpdate = millis();  } // Writes 'lastUpdateHuman'
                        
                          // 3. Check beep setting (2 seconds)
                          if    (millis() - lastBeepCheck > BEEP_CHECK_INTERVAL) {   checkBeepSetting(); checkIrLockSetting(); checkButtonLockSetting(); checkRstSetting();  lastBeepCheck = millis();  }
                        
                          // 4. NEW: Check automation setting (5 seconds)
                          if    (millis() - lastAutomationCheck > AUTOMATION_CHECK_INTERVAL) {  checkAutomationSetting();  checkAndExecuteAutomation();    lastAutomationCheck = millis();  }
                          
                          // 5. Retry relay sync if initial sync failed (10 seconds)
                          if    (!initialSyncCompleted && millis() - lastSyncAttempt > SYNC_RETRY_INTERVAL)   {  Serial.println("🔄 Retrying relay sync...");   syncRelaysWithRTDB();    lastSyncAttempt = millis();  }
                        
                          // 6. Retry relay sync if initial sync failed (10 seconds)
                          if    (initialSyncCompleted && millis() - lastSyncAttempt2 > SYNC_RETRY_INTERVAL2)  {  Serial.println("🔄 Retrying relay sync..."); handleFirmwareUpdate();  syncRelaysWithRTDB();    lastSyncAttempt2 = millis();  }
                          
                           // 7. Daily Sun Refresh
                                dailySunRefresh(); checkActiveTimers();
                        
                          delay(20); // Small delay to prevent watchdog reset/starvation
                          }                        
                                                   
                         

void ALL_LOOP       ()  { IR_Loop();  BTN_Loop();  ED_Loop();  fb_loop();     }

// -------------------- LOOP --------------------


// -------------------- SETUP --------------------
void setup() {
  delay(200);
  playStartupBeep();
  delay(5000);  // Dont Reduce This Delay otherwise system not work
  Serial.begin(115200);
  Serial.println("Welcome to ROOM_2 Home Automation, please Wait...Autentication Cheking....");
  WiFi.mode(WIFI_STA);
  EEPROM.begin(sizeof(struct settings) );
  EEPROM.get( 0, user_wifi );

  // Initialize all Relay pins to OFF (HIGH on active-LOW relays)
  pinMode(RELAY1_PIN, OUTPUT);
  pinMode(RELAY2_PIN, OUTPUT);
  pinMode(RELAY3_PIN, OUTPUT);
  pinMode(RELAY4_PIN, OUTPUT);
  digitalWrite(RELAY1_PIN, HIGH);
  digitalWrite(RELAY2_PIN, HIGH);
  digitalWrite(RELAY3_PIN, HIGH);
  digitalWrite(RELAY4_PIN, HIGH);

  // Initialize Button pins with internal pull-up resistors
  pinMode(BTN1_PIN, INPUT_PULLUP);
  pinMode(BTN2_PIN, INPUT_PULLUP);
  pinMode(BTN3_PIN, INPUT_PULLUP);
  pinMode(BTN4_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN,     OUTPUT);  digitalWrite(BUZZER_PIN, LOW); // Ensure buzzer is off initially
  pinMode(ledPin,         OUTPUT);  digitalWrite(ledPin,     LOW); // Ensure buzzer is off initially
  
  currentCount = 0;  previousMillis1 = millis(); esp_info_s();

  Main_Loopp();// Authentication Cheking if Not Passed then System Will be Staked here
  dht.begin(); // Initialize the DHT sensor
  irrecv.enableIRIn();
  
  esp_info(); wifi_con();  
  WiFi.setHostname(new_hostname);   Serial.print("\nHost Name             :   "); Serial.println(new_hostname);  Serial.print("Firmware Version      :   "); Serial.println(FW_VS);
  
  // 2. Initialize NTP Time
  if (WiFi.status() == WL_CONNECTED) { initTime(); }     
  
  // 3. Initialize Firebase
  initFirebase();

  // 4. Initial Status Updates (less noisy now)
  updateDeviceInfo(); // Writes IP/MAC/SSID/Model once
  updateDeviceStatus(); // Writes initial Human-readable timestamp

  // 6. Initial relay sync with RTDB
  Serial.println("🔄 Starting initial relay sync with RTDB...");
  syncRelaysWithRTDB();
  Serial.println("SETUP END....< STARTING LOOP..............>");
  initTimers();
}
// ------------------------SETUP END NOW----------------------------------------------------//

void loop() { Serial.println("LOOP STARTED.......>\n"); Main_Loop();    }
