// -------------------- RELAY CONTROL --------------------
void setRelay(int relayNum, bool state) {     // WITH BEEP
  relayState[relayNum] = state;
  int pin = (relayNum==0)?RELAY1_PIN:(relayNum==1)?RELAY2_PIN:(relayNum==2)?RELAY3_PIN:RELAY4_PIN; playRelayBeep(); digitalWrite(pin, state ? LOW : HIGH); 
  // RrelayPath points to the full path, e.g., HOME/ROOM_2/relay1
  Firebase.RTDB.setBool(&fbdo, RrelayPath[relayNum].c_str(), state);
  Serial.printf("Relay%d set to: %s (via IR/BTN)\n", relayNum+1, state?"ON":"OFF"); 
   }

// -------------------- RELAY CONTROL --------------------
void setRelayNB(int relayNum, bool state) {   // WNB= WITH NO BEEP
  relayState[relayNum] = state;
  int pin = (relayNum==0)?RELAY1_PIN:(relayNum==1)?RELAY2_PIN:(relayNum==2)?RELAY3_PIN:RELAY4_PIN; digitalWrite(pin, state ? LOW : HIGH); //playRelayBeep();  beep no need
  // RrelayPath points to the full path, e.g., HOME/ROOM_2/relay1
  Firebase.RTDB.setBool(&fbdo, RrelayPath[relayNum].c_str(), state);
  Serial.printf("Relay%d set to: %s (via IR/BTN)\n", relayNum+1, state?"ON":"OFF"); 
   }


// -------------------- DYNAMIC SCHEDULE AUTOMATION --------------------
void checkAndExecuteAutomation() {
  if (!automationEnabled || !Firebase.ready()) {
    return;
  }

  // Get current time
  struct tm timeinfo;  if (!getLocalTime(&timeinfo)) {  Serial.println("Failed to obtain time for automation || Restarting...System"); 
  delay(530); ESP.restart();    return;  }

  // Format current time as HH:MM
  char currentTime[6];  strftime(currentTime, sizeof(currentTime), "%H:%M", &timeinfo);  
  // Get current day of week (0=Sunday, 6=Saturday)
  int currentDay = timeinfo.tm_wday;
  // Format current time as HH:MM
  
  // DYNAMIC SCHEDULE DETECTION: i, i++ approach
  Serial.println("🔍 Scanning for automation schedules...");
  int scheduleId = 1; // Start from schedule1
  bool scheduleFound = true;
  int scheduleCount = 0;
  
  while (scheduleFound && scheduleId <= 50) { // Safety limit: max 50 schedules
    String schedulePath = "HOME/ROOM_2/automation/schedule" + String(scheduleId);
    
    // Check if this schedule exists and is enabled
    if (Firebase.RTDB.getBool(&fbdo, (schedulePath + "/enabled").c_str())) {
      bool scheduleEnabled = fbdo.boolData();
      
      if (scheduleEnabled) {
        // Get target relay for this schedule
        if (Firebase.RTDB.getInt(&fbdo, (schedulePath + "/relay").c_str())) {
          int targetRelay = fbdo.intData() - 1; // Convert to zero-based
          
          if (targetRelay >= 0 && targetRelay < 4) { // Validate relay number
            // Get schedule type
            if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/type").c_str())) {
              String scheduleType = fbdo.stringData();
              
              scheduleCount++;
              Serial.printf("  Found schedule%d for relay%d: %s\n", scheduleId, targetRelay + 1, scheduleType.c_str());
              
              if (scheduleType == "daily") {
                executeDailySchedule(scheduleId, targetRelay, schedulePath, currentTime);
              } else if (scheduleType == "weekly") {
                executeWeeklySchedule(scheduleId, targetRelay, schedulePath, currentTime, currentDay);
              } else if (scheduleType == "sunrise") {
                executeSunriseSchedule(scheduleId, targetRelay, schedulePath);
              } else if (scheduleType == "sunset") {
                executeSunsetSchedule(scheduleId, targetRelay, schedulePath);
              } else if (scheduleType == "temperature") {
                executeTemperatureSchedule(scheduleId, targetRelay, schedulePath);  // TEMPERATURE AUTOMATION
              } else if (scheduleType == "timer") {
                executeTimerSchedule(scheduleId, targetRelay, schedulePath);
              }
            }
          } else {
            Serial.printf("  ⚠ Schedule%d: Invalid relay number\n", scheduleId);
          }
        }
      }
      scheduleId++; // Check next schedule ID
    } else {
      // No more schedules found
      scheduleFound = false;
      if (scheduleCount > 0) {
        Serial.printf("✅ Automation scan complete. Found %d schedules\n", scheduleCount);
      }
    }
    
    delay(50); // Small delay between Firebase calls
  }
}

void executeDailySchedule(int scheduleId, int relay, String schedulePath, char* currentTime) {
  // Get ON time
  if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/onTime").c_str())) {
    String onTime = fbdo.stringData();
    
    // Get OFF time
    if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/offTime").c_str())) {
      String offTime = fbdo.stringData();
      
      // Compare times
      if (strcmp(currentTime, onTime.c_str()) == 0) {
        setRelayNB(relay, true);
        Serial.printf("🤖 Schedule%d: Relay%d ON at %s\n", scheduleId, relay + 1, onTime.c_str());   //     playAutomationBeep();
        
        // Update last execution time
        Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                "Executed: " + String(currentTime));
      }
      
      if (strcmp(currentTime, offTime.c_str()) == 0) {  
        setRelayNB(relay, false);
        Serial.printf("🤖 Schedule%d: Relay%d OFF at %s\n", scheduleId, relay + 1, offTime.c_str()); //        playAutomationBeep();
        
        // Update last execution time
        Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                "Executed: " + String(currentTime));
      }
    }
  }
}

void executeWeeklySchedule(int scheduleId, int relay, String schedulePath, char* currentTime, int currentDay) {
  // Get days string (e.g., "0,1,2" for Sun,Mon,Tue)
  if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/days").c_str())) {
    String daysStr = fbdo.stringData();
    
    // Check if current day is in the days string
    if (daysStr.indexOf(String(currentDay)) != -1) {
      // Get ON time
      if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/onTime").c_str())) {
        String onTime = fbdo.stringData();
        
        // Get OFF time
        if (Firebase.RTDB.getString(&fbdo, (schedulePath + "/offTime").c_str())) {
          String offTime = fbdo.stringData();
          
          // Compare times
          if (strcmp(currentTime, onTime.c_str()) == 0) {
            setRelayNB(relay, true);
            Serial.printf("🤖 Schedule%d: Relay%d ON at %s (Day: %d)\n", scheduleId, relay + 1, onTime.c_str(), currentDay); //            playAutomationBeep();
            
            Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                    "Executed: " + String(currentTime));
          }
          
          if (strcmp(currentTime, offTime.c_str()) == 0) {
            setRelayNB(relay, false);
            Serial.printf("🤖 Schedule%d: Relay%d OFF at %s (Day: %d)\n", scheduleId, relay + 1, offTime.c_str(), currentDay);    //            playAutomationBeep();
            
            Firebase.RTDB.setString(&fbdo, (schedulePath + "/lastRun").c_str(), 
                                    "Executed: " + String(currentTime));
          }
        }
      }
    }
  }
}


